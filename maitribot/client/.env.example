# Copy to maitribot/client/.env.local (gitignored). Every VITE_* value is inlined into the
# public JS bundle, so none of these may be a secret.

# NutraSmart API base URL, e.g. http://localhost:8000/api for a local edge.
VITE_API_URL=<api base url>

# Google OAuth web client ID (public identifier).
VITE_GOOGLE_CLIENT_ID=<client id>.apps.googleusercontent.com

# Shen.AI SDK key: public by necessity, so restrict it to the app's origins in the vendor portal.
VITE_SHENAI_API_KEY=<shen.ai api key>

# Optional request deadlines in milliseconds (defaults shown; see src/config.js).
VITE_API_TIMEOUT_MS=30000
VITE_FACE_SCAN_TIMEOUT_MS=280000
VITE_UPLOAD_TIMEOUT_MS=120000
