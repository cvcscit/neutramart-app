# Deploy parameters for the NutraSmart edge (FastAPI on ECS Fargate). lib.sh sources this file for
# setup.sh, deploy.sh, setup-https.sh and teardown.sh, and deploy_helpers.py fills the <NAME>
# placeholders in task-definition.json from it. Nothing here is a secret: CF_ORIGIN_SECRET exists only
# in SSM (/nutrasmart/cf-origin-secret). One KEY=VALUE per line, comments on their own lines.

# The account the scripts must run against; they stop when AWS_PROFILE resolves to any other. Production
# stays in the account that serves nutrasmart.in (owner's decision, 2026-10-27); the September copy in
# 792207721590 is not used. That account is shared with another project.
EXPECTED_ACCOUNT_ID=209479309679
PROJECT=nutrasmart
# The edge's own region: ECS, ALB, ECR, SSM parameters and its log group.
AWS_REGION=ap-south-1

# Data residency (backend/app/config.py): unmapped countries go to DEFAULT_DATA_REGION, and each
# data region has one bucket. A region without a bucket answers 503.
DEFAULT_DATA_REGION=us-east-1
BUCKET_US=sci-neutrasmart-project-us
BUCKET_IN=sci-neutrasmart-project
BUCKET_CA=sci-neutrasmart-project-ca
BUCKET_EU=sci-neutrasmart-project-eu
# Region assumed when a runtime ARN can't be parsed (backend/app/agent_client.py).
AGENTCORE_REGION=us-east-1

# CORS origins for production; never localhost. The client is served at both names.
ALLOWED_ORIGINS=https://nutrasmart.in,https://app.nutrasmart.in
# Origins let through without X-Origin-Verify. Empty: CloudFront adds the header in this account.
ORIGIN_VERIFY_EXEMPT_ORIGINS=

# Public OAuth web client ID. setup.sh stores it as /nutrasmart/google-client-id when that parameter
# does not exist yet; an existing parameter is never overwritten.
GOOGLE_CLIENT_ID=

# Names setup-https.sh certifies and points at the ALB.
DOMAIN=nutrasmart.in
API_DOMAIN=api.nutrasmart.in
