# Copy to backend/.env for local runs (gitignored). In ECS these come from the task
# definition's environment and its SSM `secrets` block (backend/ecs/task-definition.json).

# Local AWS credentials (never set in ECS: the task role is used there).
AWS_PROFILE=<local profile>
AWS_REGION=ap-south-1

# Google OAuth web client ID (public identifier; the client uses the same value).
GOOGLE_CLIENT_ID=<client id>.apps.googleusercontent.com

# Comma-separated CORS origins. No localhost entries in production.
ALLOWED_ORIGINS=http://localhost:5174

# Data residency: one bucket and one AgentCore runtime per region. Required: a region whose
# bucket (or runtime ARN, unless AGENT_LOCAL_URL is set) is missing answers 503.
DEFAULT_DATA_REGION=us-east-1
BUCKET_US=<bucket in us-east-1>
BUCKET_IN=<bucket in ap-south-1>
BUCKET_CA=<bucket in ca-central-1>
BUCKET_EU=<bucket in eu-west-1>
AGENT_ARN_US=<runtime ARN in us-east-1>
AGENT_ARN_IN=<runtime ARN in ap-south-1>
AGENT_ARN_CA=<runtime ARN in ca-central-1>
AGENT_ARN_EU=<runtime ARN in eu-west-1>

# Local agent instead of AgentCore (e.g. http://localhost:8080); runtime ARNs are then ignored.
AGENT_LOCAL_URL=

# CloudFront shared secret. Leave empty locally to skip the X-Origin-Verify check.
CF_ORIGIN_SECRET=
# Origins allowed past that check without the header. Empty unless the S3 demo build needs it.
ORIGIN_VERIFY_EXEMPT_ORIGINS=

# Optional tuning (defaults shown).
MAX_DAILY_UPLOADS=1000
S3_CONNECT_TIMEOUT_S=5
S3_READ_TIMEOUT_S=30
AWS_MAX_RETRIES=3
GOOGLE_CERTS_TIMEOUT_S=5
AGENT_INVOKE_READ_TIMEOUT_S=300
AGENT_LOCAL_TIMEOUT_S=180
